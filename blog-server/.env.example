# 复制成 .env 后按自己的环境修改：cp .env.example .env
# 注意 .env 已被 .gitignore 忽略，不要提交真实密码

# 后端服务端口
APP_PORT = 8888

# ---------- 数据库 ----------
# Docker 部署时改成 compose 的服务名 db
MYSQL_HOST = 127.0.0.1
MYSQL_PORT = 3306
MYSQL_USER = root
MYSQL_PASSWORD = 请填写数据库密码
MYSQL_DB = online_blog

# ---------- 内置超管 ----------
# 账号固定为 admin，密码在这里设置
ADMIN_PASSWORD = 请设置一个强密码

# ---------- 上传方式 ----------
# local 本地上传 / minio 对象存储 / qiniu 七牛云 / online 服务器
UPLOADTYPE = 'local'

# ---------- 对象存储（UPLOADTYPE=minio 或 qiniu 时才需要）----------
ACCESSKEY =
SECRETKEY =
BUCKET =
REGIN =
DOMAIN =
MINIO_PATH =

# ---------- JWT ----------
# 生产环境请换成 32 字节以上的随机串
# 注意：Node 版与 Java 版要填同一个值，否则两边签发的 token 互不认
JWT_SECRET = 请改成随机长字符串
