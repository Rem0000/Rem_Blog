# /etc/blog-java/blog-java.env
# 由 deploy/setup-java-manual.sh 生成；手工部署时按需修改后：
#   sudo systemctl restart blog-java-server
#
# 语法是 systemd EnvironmentFile：KEY=VALUE，一行一个，不要用 shell 的 export。
# 值里有空格或特殊字符时用双引号包起来。

# ---------- 端口（与现有 nginx 配置对齐）----------
APP_PORT=8888
CHAT_WS_PORT=8889

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=blog
MYSQL_PASSWORD=change-me
MYSQL_DB=online_blog

# 显式给 Spring 标准变量：即使 jar 里误带了 application-local.yml，
# 也不会连到本机开发库 / 使用其中写死的密码。
# 改 MYSQL_DB / MYSQL_PORT 时，同步改下面的 URL（脚本生成时会自动对齐）
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/online_blog?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&zeroDateTimeBehavior=convertToNull
SPRING_DATASOURCE_USERNAME=blog
SPRING_DATASOURCE_PASSWORD=change-me

# ---------- 内置超管（账号固定 admin）----------
ADMIN_PASSWORD=change-me

# ---------- JWT ----------
# 生产环境必须换成随机长串；如果要从旧环境迁移并互认 token，要沿用旧值
JWT_SECRET=change-me

# ---------- 上传方式：oss / local / online ----------
# Java 版未实现 qiniu / minio
UPLOADTYPE=oss

# ---------- 阿里云 OSS（UPLOADTYPE=oss 时必填）----------
OSS_ENDPOINT=
OSS_BUCKET_NAME=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
OSS_DOMAIN=
OSS_DIR=images/
OSS_REFERER=
OSS_PUBLIC_READ=true

# ---------- JVM ----------
# 小内存虚拟机建议固定堆大小；有大内存可改成 -XX:MaxRAMPercentage=75
JAVA_OPTS="-Xms256m -Xmx512m -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8"
