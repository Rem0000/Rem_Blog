# Java 后端 Docker 部署的环境变量
#
# 用法：cd deploy/java && cp .env.example .env && vi .env
# setup-java-docker.sh 首次运行会自动复制本文件并生成随机密码/密钥。
#
# 注意：本文件会被 .gitignore 忽略；不要提交 .env。
# 值里如果要写 $，需要写成 $$（Compose 会做变量插值）；密码建议只用字母数字。

# ---------- 宿主机端口 ----------
# 网站入口（80 被占用时改成 8080，然后用 http://IP:8080/ 访问）
HTTP_PORT=80
# 后端接口 / Swagger 直连端口
APP_PORT=8888
# 聊天 WebSocket 端口
WS_PORT=8889

# ---------- MySQL（compose 内部服务 db）----------
# root 只用于容器初始化，应用使用下面的 MYSQL_USER / MYSQL_PASSWORD
# 下面四个密码/密钥留空：要么让 setup-java-docker.sh 自动生成，要么自己填
MYSQL_ROOT_PASSWORD=
MYSQL_DB=online_blog
MYSQL_USER=blog
MYSQL_PASSWORD=

# ---------- 内置超管（账号固定 admin）----------
ADMIN_PASSWORD=

# ---------- JWT ----------
# 生产环境必须换成随机长串；Java 与 Node 要共用同一个值才能互认 token
JWT_SECRET=

# ---------- 上传方式：oss / local / online ----------
# Java 版未实现 qiniu / minio；默认 oss（生产推荐）
UPLOADTYPE=oss

# ---------- 阿里云 OSS（UPLOADTYPE=oss 时必填）----------
OSS_ENDPOINT=
OSS_BUCKET_NAME=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 可选：自定义域名 / CDN，留空则用 https://<bucket>.<endpoint>
OSS_DOMAIN=
OSS_DIR=images/
# 可选：防盗链白名单里的主域名，留空自动用上传请求的 Origin/Referer
OSS_REFERER=
OSS_PUBLIC_READ=true

# ---------- JVM ----------
JAVA_OPTS=-XX:MaxRAMPercentage=75 -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8

# ---------- Maven（仅构建镜像时用）----------
# 海外机器可以换成 https://repo.maven.apache.org/maven2
MAVEN_MIRROR=https://maven.aliyun.com/repository/public
