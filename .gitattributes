# 统一按 LF 存储，避免脚本在 Linux 上因 CRLF 报 "$'\r': command not found"
* text=auto eol=lf

# Shell 脚本必须是 LF
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.service text eol=lf

# Windows 批处理保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.jar binary
*.zip binary
